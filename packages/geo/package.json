{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/geo",
  "version": "0.5.20",
  "description": "Places on the Earth: WGS84 points, great-circle distance and bearing, boxes across the antimeridian, point-in-polygon and overlap for GeoJSON on exact predicates, the area of a polygon and of an overlap, geohashes, lines joined at common ends with the nearest point and a point along a line, map projections to a plane in metres, readers of shapefiles and dbf files, and road graphs for routes with no network.",
  "keywords": [
    "geo",
    "geojson",
    "wgs84",
    "haversine",
    "great-circle",
    "point-in-polygon",
    "bounding-box",
    "antimeridian",
    "geohash",
    "projection",
    "web-mercator",
    "road-graph",
    "routing",
    "openstreetmap",
    "shapefile"
  ],
  "homepage": "https://github.com/mark1russell7/geo/tree/main/packages/geo#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/geo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/geo.git",
    "directory": "packages/geo"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./projection": "./src/projection.ts",
    "./shapefile": "./src/shapefile.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./projection": {
        "types": "./dist/projection.d.ts",
        "import": "./dist/projection.js",
        "default": "./dist/projection.js"
      },
      "./shapefile": {
        "types": "./dist/shapefile.d.ts",
        "import": "./dist/shapefile.js",
        "default": "./dist/shapefile.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/optional": "^1.2.0",
    "@mark1russell7/predicates": "^0.1.5"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/rigor-testkit": "^0.2.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
