{
  "$schema": "https://json.schemastore.org/package",
  "name": "@geo/bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "bench": "node src/bench.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/predicates": "^0.1.4",
